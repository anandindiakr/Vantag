<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>#NeverBlink 90-Day Campaign Kit</title>
<style>
/* === CORE THEME === */
:root {
  --neon-green: #00FF88;
  --neon-blue: #00CCFF;
  --bg: #121212;
  --surface: #1a1a1a;
  --surface-elevated: #222222;
  --text: #f0f0f0;
  --text-secondary: #b0b0b0;
  --border: #333333;
  --red-accent: #ff4444;
  --amber-accent: #ffaa00;
  --font: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
  --radius: 8px;
  --gap: 16px;
}

* { box-sizing: border-box; }

html { scroll-behavior: smooth; }

body {
  margin: 0;
  font-family: var(--font);
  background: var(--bg);
  color: var(--text);
  line-height: 1.5;
  font-size: 16px;
}

/* === PRINT RESET === */
@media print {
  :root {
    --bg: #ffffff;
    --surface: #f8f9fa;
    --surface-elevated: #ffffff;
    --text: #111111;
    --text-secondary: #444444;
    --neon-green: #008855;
    --neon-blue: #006699;
    --border: #cccccc;
    --red-accent: #cc0000;
    --amber-accent: #cc7700;
  }
  body { background: var(--bg) !important; color: var(--text) !important; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  .no-break { page-break-inside: avoid; }
  .page-break { page-break-before: always; }
  details { page-break-inside: avoid; }
  summary { list-style: none; cursor: default; }
}

/* === TYPOGRAPHY === */
h1, h2, h3, h4 {
  margin: 0 0 0.6em 0;
  line-height: 1.2;
  font-weight: 700;
}
h1 { font-size: 2.2rem; letter-spacing: -0.02em; }
h2 { font-size: 1.5rem; color: var(--neon-green); border-bottom: 1px solid var(--border); padding-bottom: 8px; }
h3 { font-size: 1.15rem; color: var(--neon-blue); margin-top: 1.2em; }
p { margin: 0 0 1em 0; }
a { color: var(--neon-blue); text-decoration: underline; text-underline-offset: 3px; }

/* === LAYOUT === */
.container { max-width: 1100px; margin: 0 auto; padding: 24px; }
section, details { margin-bottom: 32px; }
summary {
  cursor: pointer;
  padding: 16px;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--neon-green);
  list-style: none;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
summary::after { content: "▸"; font-size: 1.2rem; transition: transform 0.2s; color: var(--neon-blue); }
details[open] > summary::after { content: "▾"; }
details > div { padding: 20px; border: 1px solid var(--border); border-top: none; border-radius: 0 0 var(--radius) var(--radius); background: var(--surface-elevated); }

/* === HERO === */
.hero {
  text-align: center;
  padding: 60px 20px;
  background: linear-gradient(135deg, #0a0a0a 0%, #1a1a2e 100%);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  position: relative;
  overflow: hidden;
}
.hero::before {
  content: "";
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 50% 50%, rgba(0,255,136,0.08), transparent 70%);
  pointer-events: none;
}
.hero h1 {
  font-size: 2.8rem;
  background: linear-gradient(90deg, var(--neon-green), var(--neon-blue));
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  margin-bottom: 12px;
}
.hero p {
  font-size: 1.15rem;
  color: var(--text-secondary);
  max-width: 700px;
  margin: 0 auto 24px;
}
.hero-brands { display: flex; justify-content: center; gap: 24px; flex-wrap: wrap; margin-top: 24px; }
.brand-pill {
  border: 1px solid var(--neon-blue);
  padding: 12px 24px;
  border-radius: 999px;
  font-weight: 600;
  color: var(--neon-blue);
  background: rgba(0,204,255,0.06);
}

/* === INFOGRAPHIC UTILITIES === */
.infographic-container { display: flex; flex-direction: column; gap: 24px; }
.slide {
  background: var(--surface);
  border: 1px solid var(--border);
  border-left: 4px solid var(--neon-green);
  border-radius: var(--radius);
  padding: 24px;
  position: relative;
  overflow: hidden;
}
.slide-alt { border-left-color: var(--neon-blue); }
.slide-amber { border-left-color: var(--amber-accent); }
.slide-red { border-left-color: var(--red-accent); }

.slide-header { display: flex; align-items: center; gap: 16px; margin-bottom: 12px; }
.slide-icon {
  width: 48px; height: 48px;
  display: grid; place-items: center;
  border-radius: var(--radius);
  background: var(--surface-elevated);
  border: 1px solid var(--border);
  font-size: 1.5rem;
  flex-shrink: 0;
}
.slide h3 { margin: 0; }

/* Specific slide visual treatments */
.glow-chip {
  display: inline-block; width: 80px; height: 80px; background: #0f2e1f;
  border: 2px solid var(--neon-green); border-radius: 8px; position: relative;
  box-shadow: 0 0 24px rgba(0,255,136,0.25);
}
.glow-chip::before {
  content: "◉"; color: var(--neon-green); font-size: 2rem;
  position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
}

.split-bg {
  background: linear-gradient(90deg, #1f1f1f 50%, #112211 50%);
}
.cloud-box {
  background: linear-gradient(135deg, #2a1f1f, #1f1f2a);
  border: 1px dashed var(--red-accent);
}

/* ROI Panels */
.roi-panels { display: grid; gap: 16px; }
.roi-panel {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 24px;
}
.roi-big { font-size: 2.4rem; font-weight: 800; display: block; margin-bottom: 4px; }
.roi-green { color: var(--neon-green); }
.roi-blue { color: var(--neon-blue); }
.roi-equation {
  display: flex; align-items: center; justify-content: center; gap: 16px; flex-wrap: wrap;
  font-size: 1.2rem; padding: 16px; background: #0f1f1f; border-radius: var(--radius);
}

/* Cloud vs Edge */
.pipeline-wrap { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
@media (max-width: 700px) { .pipeline-wrap { grid-template-columns: 1fr; } }

.pipeline-col { display: flex; flex-direction: column; gap: 12px; }
.flow-box {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 14px;
  text-align: center;
}
.flow-box strong { display: block; margin-bottom: 4px; }
.flow-arrow { text-align: center; font-size: 1.4rem; color: var(--text-secondary); }
.cloud-path .flow-box { border-left: 3px solid var(--red-accent); }
.edge-path .flow-box { border-left: 3px solid var(--neon-green); }
.cloud-path .flow-box:last-child { background: rgba(255,68,68,0.08); }
.edge-path .flow-box:last-child { background: rgba(0,255,136,0.08); }

/* === TABLE === */
table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.95rem;
  margin-top: 8px;
}
thead th {
  text-align: left;
  padding: 12px;
  background: var(--surface);
  border-bottom: 2px solid var(--neon-green);
  color: var(--neon-green);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  font-size: 0.85rem;
}
tbody td {
  padding: 12px;
  border-bottom: 1px solid var(--border);
  vertical-align: top;
}
tbody tr:hover { background: rgba(0,255,136,0.04); }
@media print {
  tbody tr { page-break-inside: avoid; }
}

.phase-agitate td:first-child { border-left: 4px solid var(--neon-green); }
.phase-educate td:first-child { border-left: 4px solid var(--neon-blue); }
.phase-convert td:first-child { border-left: 4px solid var(--amber-accent); }

.tag {
  display: inline-block;
  padding: 2px 8px;
  border-radius: 4px;
  font-size: 0.8rem;
  font-weight: 700;
}
.tag-agitate { background: rgba(0,255,136,0.12); color: var(--neon-green); border: 1px solid rgba(0,255,136,0.25); }
.tag-educate { background: rgba(0,204,255,0.12); color: var(--neon-blue); border: 1px solid rgba(0,204,255,0.25); }
.tag-convert { background: rgba(255,170,0,0.12); color: var(--amber-accent); border: 1px solid rgba(255,170,0,0.25); }

/* === CONTENT HUBS === */
.hub-post {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 20px;
  margin-bottom: 16px;
}
.hub-post h4 { color: var(--neon-blue); margin: 0 0 8px 0; font-size: 1.05rem; }
.hub-post-body { color: var(--text-secondary); font-size: 0.95rem; white-space: pre-line; }
.hub-cta { color: var(--neon-green); font-weight: 700; margin-top: 8px; display: block; }
.reel-hook { color: var(--neon-green); font-weight: 700; display: block; margin-bottom: 6px; }
.reel-hashtags { color: var(--text-secondary); font-size: 0.85rem; margin-top: 8px; display: block; }
.tweet { margin-bottom: 12px; padding-left: 16px; border-left: 2px solid var(--neon-blue); }
.tweet b { color: var(--text); }

/* === VIDEO STORYBOARD === */
.storyboard {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 20px;
  margin-bottom: 20px;
}
.shot {
  display: grid;
  grid-template-columns: 100px 1fr;
  gap: 16px;
  padding: 12px 0;
  border-bottom: 1px solid var(--border);
}
.shot:last-child { border-bottom: none; }
.shot-time {
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, monospace;
  color: var(--neon-green);
  font-weight: 700;
}

/* === DESIGNER BRIEF === */
.brief-box {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 24px;
  margin-bottom: 20px;
}
.bilingual {
  background: #1a1f1a;
  border: 1px solid rgba(0,255,136,0.2);
  padding: 20px;
  border-radius: var(--radius);
  font-size: 0.95rem;
}
.bilingual .hindi {
  color: var(--neon-green);
  font-style: italic;
  margin-bottom: 8px;
  display: block;
}

/* === UTILITY === */
.mt-2 { margin-top: 8px; }
.mt-4 { margin-top: 16px; }

/* === PRINT BUTTON === */
.print-bar {
  position: sticky;
  top: 0;
  z-index: 1000;
  background: rgba(18,18,18,0.95);
  backdrop-filter: blur(8px);
  border-bottom: 1px solid var(--border);
  padding: 12px 24px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
@media print { .print-bar { display: none; } }
.btn {
  background: transparent;
  color: var(--neon-green);
  border: 1px solid var(--neon-green);
  padding: 8px 18px;
  border-radius: var(--radius);
  cursor: pointer;
  font-family: var(--font);
  font-weight: 600;
}
.btn:hover { background: rgba(0,255,136,0.1); }

/* === FOOTER === */
.footer {
  text-align: center;
  padding: 40px 20px;
  border-top: 2px solid var(--neon-green);
  margin-top: 40px;
  color: var(--text-secondary);
  font-size: 0.95rem;
}
.footer strong { color: var(--neon-green); }
</style>
</head>
<body>

<div class="print-bar">
  <span style="font-weight:700; color:var(--neon-green);">#NeverBlink</span>
  <button class="btn" onclick="document.querySelectorAll('details').forEach(d=>d.open=true); window.print();">Expand All & Print to PDF</button>
</div>

<div class="container">

  <!-- HERO -->
  <section class="hero no-break">
    <h1>#NeverBlink</h1>
    <p>90-Day Marketing Campaign Kit</p>
    <p>Turning passive CCTV into active AI-powered security.<br>
    From evidence lockers to real-time guardians — edge AI that alerts in 0.4 seconds.</p>
    <div class="hero-brands">
      <div class="brand-pill">Retail-Vantag · S$39/mo · SG/MY</div>
      <div class="brand-pill" style="border-color:var(--neon-green); color:var(--neon-green);">Retail Nazar · ₹1,999/mo · India</div>
    </div>
  </section>

  <!-- INFOGRAPHIC 1 -->
  <details open>
    <summary>Infographic 1: 5 Blind Spots Costing Retailers Thousands</summary>
    <div>
      <div class="infographic-container">
        <!-- Slide 1 -->
        <div class="slide split-bg no-break">
          <div style="text-align:center; padding: 24px 0;">
            <div style="font-size:1.6rem; font-weight:800; margin-bottom:8px;">Your CCTV Helps You File an Insurance Claim.</div>
            <div style="font-size:1.3rem; color:var(--neon-green); font-weight:700;">Vantag Helps You Prevent the Theft.</div>
          </div>
        </div>

        <!-- Slide 2 -->
        <div class="slide no-break">
          <div class="slide-header">
            <div class="slide-icon">😴</div>
            <h3>Blind Spot 1: Nobody Is Watching Live</h3>
          </div>
          <p>Less than 1% of CCTV footage is ever reviewed. By the time you look, the thief is gone.</p>
        </div>

        <!-- Slide 3 -->
        <div class="slide no-break">
          <div class="slide-header">
            <div class="slide-icon">⏱</div>
            <h3>Blind Spot 2: Theft Is Faster Than Human Reaction</h3>
          </div>
          <p>The average shoplifter needs <strong>13 seconds</strong> to conceal an item. A guard glancing at 8 monitors will miss it.</p>
        </div>

        <!-- Slide 4 -->
        <div class="slide no-break">
          <div class="slide-header">
            <div class="slide-icon">🚪</div>
            <h3>Blind Spot 3: After-Hours Is a Free-for-All</h3>
          </div>
          <p>Without real-time alerts, you discover break-ins when you turn the key at 9 AM.</p>
        </div>

        <!-- Slide 5 -->
        <div class="slide no-break">
          <div class="slide-header">
            <div class="slide-icon">🐈</div>
            <h3>Blind Spot 4: "Smart" Motion Detection Isn't Smart</h3>
          </div>
          <p>A stray cat and a crowbar both trigger "motion detected." One wakes you at 2 AM. The other robs you.</p>
        </div>

        <!-- Slide 6 -->
        <div class="slide cloud-box no-break">
          <div class="slide-header">
            <div class="slide-icon">☁️</div>
            <h3>Blind Spot 5: Cloud Analysis = Latency + Privacy Risk</h3>
          </div>
          <p>Uploading video to analyse it adds 5–15 seconds. And your footage lives on someone else's server.</p>
        </div>

        <!-- Slide 7 -->
        <div class="slide no-break">
          <div class="slide-header">
            <div class="glow-chip" style="margin-right:8px;"></div>
            <h3>The Fix: Edge AI Runs Locally</h3>
          </div>
          <p><strong>11 models</strong> analysing simultaneously. <strong>0.4-second</strong> alerts. No upload. No leak. No latency.</p>
        </div>

        <!-- Slide 8 -->
        <div class="slide slide-alt no-break" style="text-align:center;">
          <h3 style="color:var(--neon-green); margin-bottom:16px;">Start Your 14-Day Free Trial</h3>
          <div style="display:flex; justify-content:center; gap:16px; flex-wrap:wrap;">
            <div style="border:1px solid var(--neon-blue); padding:14px 24px; border-radius:8px; min-width:200px;">
              <div style="font-size:0.85rem; color:var(--text-secondary);">Singapore / Malaysia</div>
              <div style="font-size:1.2rem; font-weight:700; color:var(--neon-blue);">Retail-Vantag · S$39/mo</div>
            </div>
            <div style="border:1px solid var(--neon-green); padding:14px 24px; border-radius:8px; min-width:200px;">
              <div style="font-size:0.85rem; color:var(--text-secondary);">India</div>
              <div style="font-size:1.2rem; font-weight:700; color:var(--neon-green);">Retail Nazar · ₹1,999/mo</div>
            </div>
          </div>
          <p style="margin-top:12px; font-size:0.9rem; color:var(--text-secondary);">No credit card required.</p>
        </div>
      </div>
    </div>
  </details>

  <!-- INFOGRAPHIC 2 -->
  <details open>
    <summary>Infographic 2: The ROI of Seeing — A Math Problem</summary>
    <div>
      <div class="roi-panels">
        <div class="roi-panel no-break">
          <span class="roi-big roi-green">S$1,200 / ₹70,000</span>
          <p style="margin:0; color:var(--text-secondary);">Average value of one high-ticket shoplifting incident (electronics, designer goods, pharma).</p>
        </div>
        <div class="roi-panel no-break">
          <span class="roi-big roi-blue">S$39 / ₹1,999</span>
          <p style="margin:0; color:var(--text-secondary);">One month of Vantag Starter. All 11 AI models included.</p>
        </div>
        <div class="roi-panel roi-equation no-break">
          <span>1 Theft Prevented</span>
          <span style="font-size:1.4rem;">÷</span>
          <span>30 Months</span>
          <span style="font-size:1.4rem;">=</span>
          <span style="color:var(--neon-green); font-weight:700;">System Pays for Itself</span>
        </div>
        <div class="roi-panel no-break">
          <strong style="color:var(--neon-green);">Secondary Savings</strong>
          <ul style="margin:8px 0 0 18px; padding:0; color:var(--text-secondary);">
            <li>Reduced guard overtime from false alarms</li>
            <li>Less out-of-stock shrinkage via Empty Shelf alerts</li>
            <li>Lower insurance premiums with active monitoring proof</li>
          </ul>
        </div>
        <div class="roi-panel no-break" style="text-align:center; background:rgba(0,255,136,0.06);">
          <p style="margin:0; font-size:1.05rem; font-weight:700;">The only thing more expensive than security is replacing stolen inventory.</p>
        </div>
      </div>
    </div>
  </details>

  <!-- INFOGRAPHIC 3 -->
  <details open>
    <summary>Infographic 3: Cloud vs Edge — The Pipeline Difference</summary>
    <div>
      <div class="pipeline-wrap">
        <!-- Cloud Path -->
        <div class="pipeline-col cloud-path">
          <h3 style="text-align:center; color:var(--red-accent);">Cloud AI Pipeline</h3>
          <div class="flow-box no-break"><strong>Camera</strong><span style="color:var(--text-secondary);">Records event</span></div>
          <div class="flow-arrow">↓</div>
          <div class="flow-box no-break"><strong>Upload</strong><span style="color:var(--text-secondary);">Internet transfer</span></div>
          <div class="flow-arrow">↓</div>
          <div class="flow-box no-break"><strong>Cloud Server</strong><span style="color:var(--text-secondary);">Remote analysis</span></div>
          <div class="flow-arrow">↓</div>
          <div class="flow-box no-break"><strong>Analyse</strong><span style="color:var(--text-secondary);">Queued processing</span></div>
          <div class="flow-arrow">↓</div>
          <div class="flow-box no-break"><strong>Alert</strong><span style="color:var(--red-accent);">7–15 Seconds Delay</span></div>
        </div>

        <!-- Edge Path -->
        <div class="pipeline-col edge-path">
          <h3 style="text-align:center; color:var(--neon-green);">Edge AI Pipeline</h3>
          <div class="flow-box no-break"><strong>Camera</strong><span style="color:var(--text-secondary);">Records event</span></div>
          <div class="flow-arrow">↓</div>
          <div class="flow-box no-break"><strong>Local Edge Chip</strong><span style="color:var(--text-secondary);">On-site processing</span></div>
          <div class="flow-arrow">↓</div>
          <div class="flow-box no-break"><strong>Instant Alert</strong><span style="color:var(--neon-green);">0.4 Seconds</span></div>
          <div style="margin-top:8px; text-align:center; color:var(--text-secondary); font-size:0.9rem;">
            No upload. No bandwidth cost. No privacy leak.
          </div>
        </div>
      </div>
    </div>
  </details>

  <!-- CONTENT CALENDAR -->
  <details open>
    <summary>90-Day Content Calendar</summary>
    <div>
      <table>
        <thead>
          <tr>
            <th>Week</th>
            <th>Phase</th>
            <th>Theme</th>
            <th>Key Actions</th>
          </tr>
        </thead>
        <tbody>
          <tr class="phase-agitate">
            <td>W1</td>
            <td><span class="tag tag-agitate">Agitate</span></td>
            <td>Cameras Are Sleeping</td>
            <td>Problem carousels; Polls; "Old CCTV" reels</td>
          </tr>
          <tr class="phase-agitate">
            <td>W2</td>
            <td><span class="tag tag-agitate">Agitate</span></td>
            <td>13-Second Rule</td>
            <td>Theft speed stat posts; Before/After splits</td>
          </tr>
          <tr class="phase-agitate">
            <td>W3</td>
            <td><span class="tag tag-agitate">Agitate</span></td>
            <td>Insurance vs Prevention</td>
            <td>ROI calculators; Cost-of-loss carousels</td>
          </tr>
          <tr class="phase-agitate">
            <td>W4</td>
            <td><span class="tag tag-agitate">Agitate</span></td>
            <td>The Myth of Smart Cameras</td>
            <td>Motion detection myth-busters; Cat memes</td>
          </tr>
          <tr class="phase-educate">
            <td>W5</td>
            <td><span class="tag tag-educate">Educate</span></td>
            <td>DIY Setup Truth</td>
            <td>30-min timelapse; Compatibility lists</td>
          </tr>
          <tr class="phase-educate">
            <td>W6</td>
            <td><span class="tag tag-educate">Educate</span></td>
            <td>One Dashboard, 11 Brains</td>
            <td>Model explainer carousels; Alert replays</td>
          </tr>
          <tr class="phase-educate">
            <td>W7</td>
            <td><span class="tag tag-educate">Educate</span></td>
            <td>Customer Spotlight (Tampines/Mumbai)</td>
            <td>Case study PDF; UGC requests</td>
          </tr>
          <tr class="phase-educate">
            <td>W8</td>
            <td><span class="tag tag-educate">Educate</span></td>
            <td>Queue & Safety Alerts</td>
            <td>Operational demos; Compliance one-pagers</td>
          </tr>
          <tr class="phase-convert">
            <td>W9</td>
            <td><span class="tag tag-convert">Convert</span></td>
            <td>The Annual Trap (Offer)</td>
            <td>Annual pricing threads; Countdown stickers</td>
          </tr>
